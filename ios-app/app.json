{
  "expo": {
    "name": "AURUM",
    "slug": "aurum",
    "scheme": "aurum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030508",
    "ios": {
      "bundleIdentifier": "io.github.ashuto796boop.aurum",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.github.ashuto796boop.aurum",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#030508"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030508",
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
