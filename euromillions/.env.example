# Copiez ce fichier en .env et adaptez les valeurs. Ne versionnez jamais .env.

# Base de données (SQLite par défaut ; PostgreSQL : postgresql+psycopg://user:motdepasse@postgres:5432/euromillions)
EM_DATABASE_URL=sqlite:////data/euromillions.db
EM_AUTO_MIGRATE=true

# Sécurité : si défini, l'API exige l'en-tête X-API-Key (à saisir dans Paramètres de l'interface).
EM_API_KEY=
EM_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
EM_RATE_LIMIT_PER_MINUTE=30

# Import des tirages
EM_MAX_UPLOAD_MB=10
EM_MAX_IMPORT_ROWS=100000
EM_ALLOWED_IMPORT_HOSTS=www.fdj.fr,media.fdj.fr
EM_URL_TIMEOUT_S=20

# Limites de calcul
EM_MAX_GRIDS_PER_REQUEST=10000
EM_MAX_SIMULATION_DRAWS=5000000
EM_MAX_SIMULATION_WORK=2000000000
EM_MAX_CONCURRENT_JOBS=2
EM_MAX_OPTIMIZER_SECONDS=120
EM_EXACT_PORTFOLIO_MAX_GRIDS=100

# Jeu (valeur par défaut modifiable dans l'interface)
EM_DEFAULT_TICKET_PRICE=2.5

# Docker Compose
EM_HTTP_PORT=8080
EM_CPU_LIMIT=2
EM_MEMORY_LIMIT=2g
# POSTGRES_PASSWORD=choisissez-un-mot-de-passe
